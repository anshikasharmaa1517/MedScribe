# Leave VITE_API_BASE unset to run against the in-browser mock.
# VITE_API_BASE=https://xxxx.execute-api.ap-south-1.amazonaws.com/dev
# Cognito doctor pool client (stack output DoctorUserPoolClientId) - enables the login screen.
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REGION=ap-south-1
# VITE_ID_TOKEN=<optional: paste a token to skip the login screen, dev only>
# VITE_STT=scripted   # scripted | sarvam
