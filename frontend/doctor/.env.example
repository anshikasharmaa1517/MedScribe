# Leave VITE_API_BASE unset to run against the in-browser mock.
# VITE_API_BASE=https://xxxx.execute-api.ap-south-1.amazonaws.com/dev
# Cognito doctor pool client (stack output DoctorUserPoolClientId) - enables the login screen.
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REGION=ap-south-1
# VITE_ID_TOKEN=<optional: paste a token to skip the login screen, dev only>
# VITE_STT=scripted   # scripted | sarvam
# VITE_SARVAM_API_KEY=   # required for VITE_STT=sarvam; key is visible in the browser - local demo only
# VITE_STT_LANG=hi-IN     # or auto
# VITE_STT_MODE=codemix   # Hinglish
# VITE_STT_MODEL=saaras:v3-realtime
# VITE_WS_URL=wss://xxxx.execute-api.ap-south-1.amazonaws.com/dev   # stack output WebSocketUrl
# VITE_TRANSPORT=ws       # ws (default when VITE_WS_URL is set) | poll (instant fallback)
