# Copy to .env and fill in. Never commit .env.
# In AWS these come from Secrets Manager / SSM, not environment variables.

SARVAM_API_KEY=

# WhatsApp via the Meta Cloud API (developers.facebook.com -> app -> WhatsApp -> API Setup).
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
# App -> Settings -> Basic -> App secret. Signs every webhook POST (X-Hub-Signature-256).
WA_APP_SECRET=
# Any string you choose; Meta echoes it in the webhook verification handshake.
WA_VERIFY_TOKEN=
# The Meta test number in E.164, used to build the onboarding QR.
WA_TEST_NUMBER=
# Outbound WhatsApp logs instead of sending unless this is exactly "false".
MESSAGING_DRY_RUN=true
AWS_REGION=ap-south-1
# On-demand anthropic.* id, or an apac.* cross-region inference profile if the model
# isn't offered on-demand in ap-south-1. Discover what's visible with:
#   cd backend; python -m scripts.check_bedrock --list
BEDROCK_MODEL_ID=

# mantle (default: Bedrock's OpenAI-compatible endpoint, bearer key), gemini (free
# tier fallback) or bedrock (Converse API via the AWS keys above; blocked on new accounts).
LLM_PROVIDER=mantle
BEDROCK_API_KEY=
BEDROCK_MANTLE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
GEMINI_API_KEY=

# Optional — override where the seed CSVs are read from (defaults to backend/data/).
# MEDSCRIBE_DATA_DIR=
