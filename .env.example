# Copy to .env and fill in. Never commit .env.
# In AWS these come from Secrets Manager / SSM, not environment variables.

SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number is the same for every account; the join code is yours (Twilio console
# -> Messaging -> Try it out -> Send a WhatsApp message).
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_SANDBOX_JOIN_CODE=
# Outbound WhatsApp logs instead of sending unless this is exactly "false". 100 messages total.
MESSAGING_DRY_RUN=true
AWS_REGION=ap-south-1
# On-demand anthropic.* id, or an apac.* cross-region inference profile if the model
# isn't offered on-demand in ap-south-1. Discover what's visible with:
#   cd backend; python -m scripts.check_bedrock --list
BEDROCK_MODEL_ID=

# mantle (default: Bedrock's OpenAI-compatible endpoint, bearer key), gemini (free
# tier fallback) or bedrock (Converse API via the AWS keys above; blocked on new accounts).
LLM_PROVIDER=mantle
BEDROCK_API_KEY=
BEDROCK_MANTLE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
GEMINI_API_KEY=

# Optional — override where the seed CSVs are read from (defaults to backend/data/).
# MEDSCRIBE_DATA_DIR=
