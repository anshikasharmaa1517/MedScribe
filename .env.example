# Copy to .env and fill in. Never commit .env.
# In AWS these come from Secrets Manager / SSM, not environment variables.

SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

